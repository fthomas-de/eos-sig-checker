#: templates/eos_sig_checker/settings.html:27
#, python-format
msgid ""
"The shared list holds %(counter)s signature. Deleting empties it for "
"everybody at once; it cannot be undone."
msgid_plural ""
"The shared list holds %(counter)s signatures. Deleting empties it for "
"everybody at once; it cannot be undone."
msgstr[0] ""
"Die gemeinsame Liste enthält %(counter)s Signatur. Löschen leert sie für "
"alle auf einmal; das lässt sich nicht rückgängig machen."
msgstr[1] ""
"Die gemeinsame Liste enthält %(counter)s Signaturen. Löschen leert sie für "
"alle auf einmal; das lässt sich nicht rückgängig machen."

