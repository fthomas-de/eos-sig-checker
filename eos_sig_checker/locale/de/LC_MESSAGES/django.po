#: parser.py:164
msgid "The line holds control characters."
msgstr "Die Zeile enthält Steuerzeichen."

#: parser.py:173
msgid "Expected 6 tab-separated columns, as the probe scanner copies them."
msgstr ""
"Erwartet werden 6 durch Tabs getrennte Spalten, wie der Probe Scanner sie "
"kopiert."

#: parser.py:177
msgid "The signature ID must look like ABC-123."
msgstr "Die Signatur-ID muss wie ABC-123 aussehen."

#: parser.py:179
msgid "The site type holds characters a site type never has."
msgstr "Der Site-Typ enthält Zeichen, die ein Site-Typ nie hat."

#: parser.py:181
msgid "The name holds characters a site name never has."
msgstr "Der Name enthält Zeichen, die ein Site-Name nie hat."

#: parser.py:183
msgid "A name without a site type does not come from the probe scanner."
msgstr "Ein Name ohne Site-Typ kommt nicht aus dem Probe Scanner."

#: parser.py:188
msgid "The scan strength must be a percentage between 0 and 100."
msgstr "Die Scanstärke muss ein Prozentwert zwischen 0 und 100 sein."

#: parser.py:190
msgid "The distance must be a number with a unit."
msgstr "Die Entfernung muss eine Zahl mit Einheit sein."

