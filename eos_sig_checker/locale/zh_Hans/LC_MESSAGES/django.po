#: templates/eos_sig_checker/settings.html:30
#, python-format
msgid ""
"The shared list holds %(counter)s signature. Deleting empties it for "
"everybody at once; it cannot be undone."
msgid_plural ""
"The shared list holds %(counter)s signatures. Deleting empties it for "
"everybody at once; it cannot be undone."
msgstr[0] "共享列表中有 %(counter)s 个信号。删除会立即为所有人清空列表，且无法撤销。"

#: templates/eos_sig_checker/settings.html:47
