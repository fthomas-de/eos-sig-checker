msgid "Sig Checker"
msgstr "Sig Checker"

#: forms.py:25
msgid "Probe scanner"
msgstr "Probe Scanner"

#: forms.py:33
msgid ""
"Select the results in the probe scanner, copy them with Ctrl+C and paste "
"them here."
msgstr "在 Probe Scanner 中选中结果，用 Ctrl+C 复制并粘贴到这里。"

#: forms.py:44
#, python-format
msgid "At most %(max)d line per paste."
msgid_plural "At most %(max)d lines per paste."
msgstr[0] "每次粘贴最多 %(max)d 行。"

#: models.py:26
msgid "Can paste and resolve signatures"
msgstr "可以粘贴并解析信号"

#: models.py:27
msgid "Can change the settings and delete all signatures"
msgstr "可以更改设置并删除所有信号"

#: models.py:37
msgid "Keep signatures (days)"
msgstr "信号保留（天）"

#: models.py:39
msgid ""
"Days a signature counts after its last check. After that it is ignored and "
"removed by the daily cleanup."
msgstr "信号在最后一次检查后有效的天数。之后它将被忽略，并由每日清理删除。"

#: models.py:46
msgctxt "eos-sig-checker"
msgid "Configuration"
msgstr "配置"

#: models.py:68 templates/eos_sig_checker/index.html:102
#: templates/eos_sig_checker/signatures.html:14
#: templates/eos_sig_checker/signatures.html:34
msgid "System"
msgstr "星系"

#: models.py:83
msgid "Signature"
msgstr "信号"

#: models.py:84 templates/eos_sig_checker/base.html:15
msgid "Signatures"
msgstr "信号"

#: parser.py:90
msgid "Expected 6 tab-separated columns, as the probe scanner copies them."
msgstr "应为 6 个以制表符分隔的列，与 Probe Scanner 复制的格式相同。"

#: parser.py:94
msgid "The signature ID must look like ABC-123."
msgstr "信号 ID 必须形如 ABC-123。"

#: parser.py:96
msgid "The site type holds characters a site type never has."
msgstr "站点类型包含站点类型中不会出现的字符。"

#: parser.py:98
msgid "The name holds characters a site name never has."
msgstr "名称包含站点名称中不会出现的字符。"

#: parser.py:100
msgid "A name without a site type does not come from the probe scanner."
msgstr "没有站点类型的名称不可能来自 Probe Scanner。"

#: parser.py:105
msgid "The scan strength must be a percentage between 0 and 100."
msgstr "扫描强度必须是 0 到 100 之间的百分比。"

#: parser.py:107
msgid "The distance must be a number with AU, km or m."
msgstr "距离必须是带有 AU、km 或 m 的数字。"

#: parser.py:123
msgid "The line holds control characters."
msgstr "该行包含控制字符。"

#: templates/eos_sig_checker/base.html:18
msgctxt "eos-sig-checker"
msgid "Settings"
msgstr "设置"

#: templates/eos_sig_checker/index.html:8
#, python-format
msgid ""
"Signatures are shared with everybody who has access and count for %(days)s "
"day after their last check."
msgid_plural ""
"Signatures are shared with everybody who has access and count for %(days)s "
"days after their last check."
msgstr[0] "信号与所有有权限的人共享，在最后一次检查后 %(days)s 天内有效。"

#: templates/eos_sig_checker/index.html:16
#, python-brace-format
msgid "read {seconds} s ago"
msgstr "{seconds} 秒前读取"

#: templates/eos_sig_checker/index.html:17
msgid "The server could not be reached. The position shown may be outdated."
msgstr "无法连接服务器。显示的位置可能已过时。"

#: templates/eos_sig_checker/index.html:25
msgid "Track location"
msgstr "追踪位置"

#: templates/eos_sig_checker/index.html:28
