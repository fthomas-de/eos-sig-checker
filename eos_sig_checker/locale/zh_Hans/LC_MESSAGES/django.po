msgid_plural "No wormhole checked in the last %(hours)s hours."
msgstr[0] "最近 %(hours)s 小时内没有检查过 Wormhole。"

#: templates/eos_sig_checker/index.html:102
msgid "Pasting checks on its own"
msgstr "粘贴后会自动检查"

#: templates/eos_sig_checker/index.html:103
