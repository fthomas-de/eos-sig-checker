#: auth_hooks.py:13 templates/eos_sig_checker/index.html:5
#: templates/eos_sig_checker/index.html:9
msgid "Sig Checker"
msgstr "Sig Checker"

#: forms.py:11
msgid "Probe scanner"
msgstr "Probe Scanner"

#: forms.py:19
msgid ""
"Select the results in the probe scanner, copy them with Ctrl+C and paste "
"them here."
msgstr "在 Probe Scanner 中选中结果，用 Ctrl+C 复制并粘贴到这里。"

#: forms.py:30
#, python-format
msgid "At most %(max)d line per paste."
msgid_plural "At most %(max)d lines per paste."
msgstr[0] "每次粘贴最多 %(max)d 行。"

#: models.py:13
msgid "Can paste and resolve signatures"
msgstr "可以粘贴并解析信号"

#: models.py:40
msgid "Signature"
msgstr "信号"

#: models.py:41
msgid "Signatures"
msgstr "信号"

#: parser.py:86
msgid "Expected 6 tab-separated columns, as the probe scanner copies them."
msgstr "应为 6 个以制表符分隔的列，与 Probe Scanner 复制的格式相同。"

#: parser.py:90
msgid "The signature ID must look like ABC-123."
msgstr "信号 ID 必须形如 ABC-123。"

#: parser.py:92
msgid "The site type holds characters a site type never has."
msgstr "站点类型包含站点类型中不会出现的字符。"

#: parser.py:94
msgid "The name holds characters a site name never has."
msgstr "名称包含站点名称中不会出现的字符。"

#: parser.py:96
msgid "A name without a site type does not come from the probe scanner."
msgstr "没有站点类型的名称不可能来自 Probe Scanner。"

#: parser.py:101
msgid "The scan strength must be a percentage between 0 and 100."
msgstr "扫描强度必须是 0 到 100 之间的百分比。"

#: parser.py:103
msgid "The distance must be a number with AU, km or m."
msgstr "距离必须是带有 AU、km 或 m 的数字。"

#: parser.py:119
msgid "The line holds control characters."
msgstr "该行包含控制字符。"

#: templates/eos_sig_checker/index.html:15
#, python-format
msgid ""
"Signatures are shared with everybody who has access and count for %(days)s "
"day after their last check."
msgid_plural ""
"Signatures are shared with everybody who has access and count for %(days)s "
"days after their last check."
msgstr[0] "信号与所有有权限的人共享，在最后一次检查后 %(days)s 天内有效。"

#: templates/eos_sig_checker/index.html:26
msgid "Pasting checks on its own"
msgstr "粘贴后会自动检查"

#: templates/eos_sig_checker/index.html:27
msgid "Check"
msgstr "检查"

#: templates/eos_sig_checker/index.html:45
msgid "Result"
msgstr "结果"

#: templates/eos_sig_checker/index.html:48
msgid "Copied"
msgstr "已复制"

#: templates/eos_sig_checker/index.html:49
msgid "Copy the completed list in the probe scanner format"
msgstr "以 Probe Scanner 格式复制补全后的列表"

#: templates/eos_sig_checker/index.html:50
msgid "Copy"
msgstr "复制"

#: templates/eos_sig_checker/index.html:61
msgctxt "eos-sig-checker"
msgid "ID"
msgstr "ID"

#: templates/eos_sig_checker/index.html:62
msgctxt "eos-sig-checker"
msgid "Kind"
msgstr "种类"

#: templates/eos_sig_checker/index.html:63
msgctxt "eos-sig-checker"
msgid "Group"
msgstr "分组"

#: templates/eos_sig_checker/index.html:64
msgctxt "eos-sig-checker"
msgid "Name"
msgstr "名称"

#: templates/eos_sig_checker/index.html:65
msgctxt "eos-sig-checker"
msgid "Signal"
msgstr "信号强度"

#: templates/eos_sig_checker/index.html:66
msgid "Distance"
msgstr "距离"

#: templates/eos_sig_checker/index.html:67
msgid "Last checked"
msgstr "上次检查"

#: templates/eos_sig_checker/index.html:93
msgid "new"
msgstr "新"

#: templates/eos_sig_checker/index.html:103
msgid ""
"Paste the probe scanner on the left and press Check: every line comes back "
"here, with group and name filled in where somebody has scanned it already."
msgstr "将 Probe Scanner 内容粘贴到左侧并点击检查：每一行都会显示在这里，已有人扫描过的会补全分组和名称。"

#: templates/eos_sig_checker/index.html:109
#: templates/eos_sig_checker/partials/resolved-cell.html:4
msgid "filled in from the shared list"
msgstr "从共享列表补全"

#: templates/eos_sig_checker/index.html:115
#, python-format
msgid ""
"%(counter)s line skipped: no Cosmic Signature or Cosmic Anomaly of an "
"English client (ships, structures, other client languages)."
msgid_plural ""
"%(counter)s lines skipped: no Cosmic Signature or Cosmic Anomaly of an "
"English client (ships, structures, other client languages)."
msgstr[0] ""
"已跳过 %(counter)s 行：不是英文客户端的 Cosmic Signature 或 Cosmic Anomaly（舰船、建筑、其他客户端语言）。"

#: views.py:50
msgid "Too many checks: wait a second and press Check again."
msgstr "检查过于频繁：请等待一秒后再次点击检查。"
