msgstr "此角色的令牌已失效。请使用位置权限范围重新添加该角色。"

#: tracking.py:93
msgid "The location could not be read from ESI. Try again in a moment."
msgstr "无法从 ESI 读取位置。请稍后再试。"

#: views.py:99
msgid "Too many checks: wait a second and press Check again."
msgstr "检查过于频繁：请等待一秒后再次点击检查。"

#: views.py:140
msgid "No character given."
msgstr "未指定角色。"

#: views.py:166
msgid "Settings saved."
msgstr "设置已保存。"

#: views.py:180
#, python-format
msgid "Deleted %(count)d signature."
msgid_plural "Deleted %(count)d signatures."
