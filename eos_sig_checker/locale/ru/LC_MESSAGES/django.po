#: auth_hooks.py:13 templates/eos_sig_checker/base.html:4
#: templates/eos_sig_checker/base.html:10
#: templates/eos_sig_checker/base.html:25
msgid "Sig Checker"
msgstr "Sig Checker"

#: forms.py:35
msgid "Probe scanner"
msgstr "Probe Scanner"

#: forms.py:43
msgid ""
"Select the results in the probe scanner, copy them with Ctrl+C and paste "
"them here."
msgstr ""
"Выдели результаты в Probe Scanner, скопируй их через Ctrl+C и вставь сюда."

#: forms.py:55
#, python-format
msgid "At most %(max)d line per paste."
msgid_plural "At most %(max)d lines per paste."
msgstr[0] "Не более %(max)d строки за одну вставку."
msgstr[1] "Не более %(max)d строк за одну вставку."
msgstr[2] "Не более %(max)d строк за одну вставку."

#: models.py:37
msgid "Can paste and resolve signatures"
msgstr "Может вставлять и распознавать сигнатуры"

#: models.py:38
msgid "Can change the settings and delete all signatures"
msgstr "Может менять настройки и удалять все сигнатуры"

#: models.py:48
msgid "Keep signatures (days)"
msgstr "Хранить сигнатуры (дней)"

#: models.py:50
msgid ""
"Days a signature counts after its last check. After that it is ignored and "
"removed by the daily cleanup."
msgstr ""
"Сколько дней сигнатура действует после последней проверки. Затем она "
"игнорируется и удаляется ежедневной очисткой."

#: models.py:57
msgid "Longest wait after failed location reads (seconds)"
msgstr ""
"Максимальное ожидание после неудачных запросов местоположения (секунд)"

#: models.py:59
msgid ""
"A location that cannot be read is asked again after 5 seconds at first, then"
" later with every further failure, in 5 steps up to this many seconds."
msgstr ""
"Местоположение, которое не удалось прочитать, сначала запрашивается снова "
"через 5 секунд, затем с каждой следующей неудачей позже, в 5 шагов до этого "
"числа секунд."

#: models.py:66
msgid "Lines per paste"
msgstr "Строк на вставку"

#: models.py:67
msgid ""
"The most lines one paste may hold. A full system has a few dozen signatures "
"and anomalies."
msgstr ""
"Максимальное число строк в одной вставке. В полной системе несколько "
"десятков сигнатур и аномалий."

#: models.py:72
msgctxt "eos-sig-checker"
msgid "Configuration"
msgstr "Конфигурация"

#: models.py:94 templates/eos_sig_checker/index.html:71
#: templates/eos_sig_checker/index.html:148
#: templates/eos_sig_checker/signatures.html:14
#: templates/eos_sig_checker/signatures.html:34
msgid "System"
msgstr "Система"

#: models.py:109
msgid "Signature"
msgstr "Сигнатура"

#: models.py:110 templates/eos_sig_checker/base.html:15
#: templates/eos_sig_checker/base.html:34
msgid "Signatures"
msgstr "Сигнатуры"

#: parser.py:91
msgid "The line holds control characters."
msgstr "Строка содержит управляющие символы."

#: parser.py:96
msgid "Expected 6 tab-separated columns, as the probe scanner copies them."
msgstr ""
"Ожидается 6 столбцов, разделённых табуляцией, как их копирует Probe Scanner."

#: parser.py:100
msgid "The signature ID must look like ABC-123."
msgstr "ID сигнатуры должен выглядеть как ABC-123."

#: parser.py:102
msgid "The site type holds characters a site type never has."
msgstr "Тип сайта содержит символы, которых в типе сайта не бывает."

#: parser.py:104
msgid "The name holds characters a site name never has."
msgstr "Название содержит символы, которых в названии сайта не бывает."

#: parser.py:106
msgid "A name without a site type does not come from the probe scanner."
msgstr "Название без типа сайта не может прийти из Probe Scanner."

#: parser.py:111
msgid "The scan strength must be a percentage between 0 and 100."
msgstr "Сила сканирования должна быть процентом от 0 до 100."

#: parser.py:113
msgid "The distance must be a number with AU, km or m."
msgstr "Расстояние должно быть числом с AU, km или m."

#: templates/eos_sig_checker/base.html:18
#: templates/eos_sig_checker/settings.html:11
msgctxt "eos-sig-checker"
msgid "Settings"
msgstr "Настройки"

#: templates/eos_sig_checker/base.html:35
msgid "new in 24 h"
msgstr "новых за 24 ч"

#: templates/eos_sig_checker/base.html:36
msgid "checked in 24 h"
msgstr "проверено за 24 ч"

#: templates/eos_sig_checker/base.html:37
msgid "systems"
msgstr "систем"

#: templates/eos_sig_checker/base.html:38
msgid "scanners in 24 h"
msgstr "сканеров за 24 ч"

#: templates/eos_sig_checker/base.html:39
msgid ""
"Entries past their age by more than a day are still stored: the cleanup task"
" does not run."
msgstr ""
"Записи, истёкшие более суток назад, всё ещё хранятся: задача очистки не "
"выполняется."

#: templates/eos_sig_checker/base.html:39
msgid "waiting for cleanup"
msgstr "ждут очистки"

#: templates/eos_sig_checker/index.html:8
#, python-format
msgid ""
"Signatures are shared with everybody who has access and count for %(days)s "
"day after their last check."
msgid_plural ""
"Signatures are shared with everybody who has access and count for %(days)s "
"days after their last check."
msgstr[0] ""
"Сигнатуры видны всем, у кого есть доступ, и действуют %(days)s день после "
"последней проверки."
msgstr[1] ""
"Сигнатуры видны всем, у кого есть доступ, и действуют %(days)s дня после "
"последней проверки."
msgstr[2] ""
"Сигнатуры видны всем, у кого есть доступ, и действуют %(days)s дней после "
"последней проверки."

#: templates/eos_sig_checker/index.html:16
#, python-brace-format
msgid "read {seconds} s ago"
msgstr "прочитано {seconds} с назад"

#: templates/eos_sig_checker/index.html:17
msgid "The server could not be reached. The position shown may be outdated."
msgstr "Сервер недоступен. Показанное местоположение может быть устаревшим."

#: templates/eos_sig_checker/index.html:25
msgid "Track location"
msgstr "Отслеживать местоположение"

#: templates/eos_sig_checker/index.html:28
msgid "Tracked character"
msgstr "Отслеживаемый персонаж"

#: templates/eos_sig_checker/index.html:33
msgid "Read the location now"
msgstr "Прочитать местоположение сейчас"

#: templates/eos_sig_checker/index.html:34
msgid "Refresh"
msgstr "Обновить"

#: templates/eos_sig_checker/index.html:39
msgctxt "eos-sig-checker"
msgid "Position"
msgstr "Местоположение"

#: templates/eos_sig_checker/index.html:40
msgid "unknown"
msgstr "неизвестно"

#: templates/eos_sig_checker/index.html:46
#, python-format
msgid "None of your characters has a token with the scope %(scope)s."
msgstr "Ни у одного из ваших персонажей нет токена с областью %(scope)s."

