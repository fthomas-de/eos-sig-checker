#: auth_hooks.py:13 templates/eos_sig_checker/index.html:5
#: templates/eos_sig_checker/index.html:9
msgid "Sig Checker"
msgstr "Sig Checker"

#: forms.py:11
msgid "Probe scanner"
msgstr "Probe Scanner"

#: forms.py:19
msgid ""
"Select the results in the probe scanner, copy them with Ctrl+C and paste "
"them here."
msgstr ""
"Выдели результаты в Probe Scanner, скопируй их через Ctrl+C и вставь сюда."

#: forms.py:30
#, python-format
msgid "At most %(max)d line per paste."
msgid_plural "At most %(max)d lines per paste."
msgstr[0] "Не более %(max)d строки за одну вставку."
msgstr[1] "Не более %(max)d строк за одну вставку."
msgstr[2] "Не более %(max)d строк за одну вставку."

#: models.py:13
msgid "Can paste and resolve signatures"
msgstr "Может вставлять и распознавать сигнатуры"

#: models.py:40
msgid "Signature"
msgstr "Сигнатура"

#: models.py:41
msgid "Signatures"
msgstr "Сигнатуры"

#: parser.py:86
msgid "Expected 6 tab-separated columns, as the probe scanner copies them."
msgstr ""
"Ожидается 6 столбцов, разделённых табуляцией, как их копирует Probe Scanner."

#: parser.py:90
msgid "The signature ID must look like ABC-123."
msgstr "ID сигнатуры должен выглядеть как ABC-123."

#: parser.py:92
msgid "The site type holds characters a site type never has."
msgstr "Тип сайта содержит символы, которых в типе сайта не бывает."

#: parser.py:94
msgid "The name holds characters a site name never has."
msgstr "Название содержит символы, которых в названии сайта не бывает."

#: parser.py:96
msgid "A name without a site type does not come from the probe scanner."
msgstr "Название без типа сайта не может прийти из Probe Scanner."

#: parser.py:101
msgid "The scan strength must be a percentage between 0 and 100."
msgstr "Сила сканирования должна быть процентом от 0 до 100."

#: parser.py:103
msgid "The distance must be a number with AU, km or m."
msgstr "Расстояние должно быть числом с AU, km или m."

#: parser.py:119
msgid "The line holds control characters."
msgstr "Строка содержит управляющие символы."

#: templates/eos_sig_checker/index.html:15
#, python-format
msgid ""
"Signatures are shared with everybody who has access and count for %(days)s "
"day after their last check."
msgid_plural ""
"Signatures are shared with everybody who has access and count for %(days)s "
"days after their last check."
msgstr[0] ""
"Сигнатуры видны всем, у кого есть доступ, и действуют %(days)s день после "
"последней проверки."
msgstr[1] ""
"Сигнатуры видны всем, у кого есть доступ, и действуют %(days)s дня после "
"последней проверки."
msgstr[2] ""
"Сигнатуры видны всем, у кого есть доступ, и действуют %(days)s дней после "
"последней проверки."

#: templates/eos_sig_checker/index.html:26
